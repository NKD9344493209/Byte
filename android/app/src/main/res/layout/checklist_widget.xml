<?xml version="1.0" encoding="utf-8"?>
<!-- The BYTE checklist on the home screen: the things still to do, in a list
     that scrolls. A tap on a line ticks it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/checklist_widget_bg"
    android:paddingLeft="16dp"
    android:paddingRight="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/cw_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cw_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checklist"
                android:textColor="@color/cw_ink"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/cw_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open BYTE once to show your list"
                android:textColor="@color/cw_faint"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/cw_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="＋ Add"
            android:textColor="@color/cw_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingLeft="12dp"
            android:paddingRight="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- Every open item, however many: the list scrolls inside the widget. -->
    <ListView
        android:id="@+id/cw_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <!-- Shown in place of the list when nothing is left to do. -->
    <TextView
        android:id="@+id/cw_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text=""
        android:textColor="@color/cw_faint"
        android:textSize="14sp" />
</LinearLayout>
