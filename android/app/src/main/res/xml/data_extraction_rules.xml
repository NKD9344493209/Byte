<?xml version="1.0" encoding="utf-8"?>
<!-- BYTE keeps its own backups (Google Drive, Downloads/BYTE). Android's
     automatic backup and phone-to-phone copy are switched off: they would
     carry the vault without its key (which never leaves this phone's
     Keystore), and files of the private space that are not locked yet. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
