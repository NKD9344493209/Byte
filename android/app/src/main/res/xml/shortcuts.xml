<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the BYTE icon (or drag this to the home screen). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="record"
        android:enabled="true"
        android:icon="@drawable/ic_notification"
        android:shortcutShortLabel="@string/shortcut_record"
        android:shortcutLongLabel="@string/shortcut_record_long">
        <intent
            android:action="android.intent.action.VOICE_COMMAND"
            android:targetPackage="com.naveen.byteapp"
            android:targetClass="com.naveen.byteapp.MainActivity" />
    </shortcut>
</shortcuts>
